# Copy to .env and fill in values. Never commit .env.
# Note: EXPO_PUBLIC_* values are bundled into the app and visible to users - never put secrets here.

# Must include /api/v1, e.g. http://localhost:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_KINDE_APP_DOMAIN=
EXPO_PUBLIC_KINDE_ALLOWED_CALLBACK_URL=
EXPO_PUBLIC_KINDE_LOGOUT_REDIRECT_URL=
EXPO_PUBLIC_KINDE_CLIENT_ID=
# Audience of the Budget Buddy API registered in Kinde (Settings → APIs). Public identifier, not a secret.
EXPO_PUBLIC_KINDE_AUDIENCE=
